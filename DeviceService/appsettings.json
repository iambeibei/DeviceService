{
  "MqttSettings": {
    "Broker": "192.168.1.65",
    "Port": 1883,
    "ClientId": "worker_demo",
    "Topic": "sensor/data",
    "Username": "dev",
    "Password": "123456"
  },
  "RedisSettings": {
    "ConnectionString": "192.168.1.65:6379,password=123456,defaultDatabase=0"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "CommandProcessing": {
    "ReplyTimeoutSeconds": 15,
    "PublishRetryDelayMilliseconds": 1000,
    "GroupControlReleaseReplyTimeoutSeconds": 15,
    "StartAgingStaggerMilliseconds": 100
  },
  "GroupControl": {
    "StageTimeoutEnabled": true,
    "StageTimeoutMinutes": 10,
    "StageTimeoutRequireHalf": false,
    "HalfReleaseThresholdMode": "Ceil",
    "ExcludedRejoinMode": "OfflineWithinTimeout",
    "ExcludedRejoinTimeoutMinutes": 10,
    "RaiseFaultOnStageTimeout": true,
    "ExcludeOnAgingTerminal": true,
    "ExcludeOnDeviceOffline": true,
    "RaiseFaultOnExclusion": true,
    "ReleaseReplyVerificationEnabled": true,
    "ReleaseReplyRetryCount": 1,
    "RaiseFaultOnReleaseReplyFailure": true
  },
  "OtaUpgrade": {
    "Enabled": true,
    "BaseTimeoutMinutes": 20,
    "TimeoutIncrementMinutes": 10,
    "PollIntervalMilliseconds": 1000,
    "LevelStabilizeSeconds": 60,
    "MaxMeshLevel": 10,
    "RejectConcurrentBatchPerRack": true,
    "RaiseFaultOnIncomplete": true,
    "AbortOnLevelTimeout": false,
    "AbortOnFirstLevelFailure": true
  },
  "AgingCommandGate": {
    "OfflineReleaseTimeoutMinutes": 30
  },
  "AgingCallback": {
    "Url": "http://192.168.1.65:11282/DeviceServiceCallback/SaveAgingRecord",
    "TimeoutSeconds": 5,
    "RetryCount": 3,
    "RetryDelayMilliseconds": 500,
    "AllowInvalidServerCertificate": true
  },
  "AgingDataApi": {
    "SaveDataUrl": "http://192.168.1.65:11282/DeviceServiceCallback/SaveAgingSamplingData"
  }
}
